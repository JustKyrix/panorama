{
  "name": "adbk-panorama",
  "version": "1.0.0",
  "description": "Originalgetreuer Nachbau der Startseite des Albrecht-Dürer-Berufskollegs Düsseldorf - Bootstrap 5.3 + Sass",
  "private": true,
  "scripts": {
    "start": "npm run watch",
    "watch": "sass --watch scss/main.scss:assets/css/main.css --load-path=node_modules --style=expanded --quiet-deps",
    "build:css": "sass scss/main.scss:assets/css/main.css --load-path=node_modules --style=expanded --no-source-map --quiet-deps",
    "build:min": "sass scss/main.scss:assets/css/main.min.css --load-path=node_modules --style=compressed --no-source-map --quiet-deps",
    "build": "npm run build:css && npm run build:min",
    "serve": "npx --yes http-server . -p 4173 -c-1",
    "package": "npm run build && npm run stamp && node tools/package.mjs",
    "package:tour": "node tools/package.mjs tour",
    "stamp": "node tools/stamp.mjs",
    "package:tour1og": "node tools/package.mjs tour-1og"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ],
  "devDependencies": {
    "bootstrap": "^5.3.3",
    "sass": "^1.83.0"
  }
}
